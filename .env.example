NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only shared OWNER key that gates the dev/admin routes which spend real
# credits (brand-library, feed-photo) or rewrite the live brand kit (brand PATCH).
# Use a uuid-strength random value (e.g. `uuidgen` or `openssl rand -hex 32`).
# UNSET → those routes fail CLOSED with 503 {configured:false} (never open). Wrong
# or missing x-wo-admin-key header → 403. Never expose it with NEXT_PUBLIC_.
WO_ADMIN_KEY=

# Server-only. Create this in the OpenAI API dashboard; never expose it with NEXT_PUBLIC_.
# Without this, the AI Art Director returns 503 "not configured".
OPENAI_API_KEY=
# Optional model override for the conversational Art Director (chat + landing).
# Default is gpt-4o-mini (widely available + cheap; fires often).
# Use a reasoning model (e.g. o4-mini) to enable step-by-step reasoning.
OPENAI_ART_DIRECTOR_MODEL=gpt-4o-mini
# Optional model override for the vision design-audit pass. Default is gpt-4o
# (stronger vision judgement; the audit is rate-limited to 5/min and only runs
# when the user opens the panel, so the extra cost is a few cents per session).
# Pin to gpt-4o-mini to cut cost, or a newer vision model as it ships.
OPENAI_AUDIT_MODEL=gpt-4o
# Optional model override for the generation-first design EXTRACTION pass (reads a
# Higgsfield full-design generation and maps it into our editable element grammar).
# If UNSET, the route resolves the STRONGEST available vision model from
# GET /v1/models in the order gpt-5 → gpt-5-mini → gpt-4.1 → gpt-4o (floor) —
# composition-measurement accuracy matters most in this pipeline and the per-call
# cost is still cents. Set this to pin a specific model.
OPENAI_EXTRACT_MODEL=
# Higgsfield platform API (photo generation) — from the Higgsfield dashboard.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Optional. Trained Soul identity for the locked brand look — from the Higgsfield
# Soul training flow. When set, it is sent as soul_id so every photo carries the
# same trained identity (the consistency mechanism). Unset = generic Soul.
HIGGSFIELD_SOUL_ID=
# Optional. Fixed generation seed for reproducible photos. Unset = random per gen.
HIGGSFIELD_SEED=
