NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Create this in the OpenAI API dashboard; never expose it with NEXT_PUBLIC_.
# Without this, the AI Art Director returns 503 "not configured".
OPENAI_API_KEY=
# Optional model override for the conversational Art Director (chat + landing).
# Default is gpt-4o-mini (widely available + cheap; fires often).
# Use a reasoning model (e.g. o4-mini) to enable step-by-step reasoning.
OPENAI_ART_DIRECTOR_MODEL=gpt-4o-mini
# Optional model override for the vision design-audit pass. Default is gpt-4o
# (stronger vision judgement; the audit is rate-limited to 5/min and only runs
# when the user opens the panel, so the extra cost is a few cents per session).
# Pin to gpt-4o-mini to cut cost, or a newer vision model as it ships.
OPENAI_AUDIT_MODEL=gpt-4o
# Higgsfield platform API (photo generation) — from the Higgsfield dashboard.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
